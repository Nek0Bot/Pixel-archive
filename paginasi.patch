--- Pixel-archive-main/src/components/Pagination.jsx	1970-01-01 00:00:00.000000000 +0000
+++ Pixel-archive-main/src/components/Pagination.jsx	2026-11-26 08:30:12.000000000 +0000
@@ -0,0 +1,29 @@
+import { daftarHalaman } from '../lib/paginasi.js'
+
+// Navigasi halaman: ‹ 1 … 4 [5] 6 … 12 ›   (dipakai Home, Favorit, Aktivitas)
+// `paging` adalah objek hasil usePagination.
+export default function Pagination({ paging, satuan = 'item' }) {
+  const { halaman, totalHalaman, total, dari, sampai, pindah } = paging
+  if (totalHalaman <= 1) return null
+
+  return (
+    <nav className="paginasi" aria-label={`Halaman daftar ${satuan}`}>
+      <p className="paginasi-info" aria-live="polite">Menampilkan {dari}–{sampai} dari {total} {satuan}</p>
+      <div className="paginasi-tombol">
+        <button type="button" className="tombol kecil netral" onClick={() => pindah(halaman - 1)}
+          disabled={halaman === 1} aria-label="Halaman sebelumnya">‹</button>
+        {daftarHalaman(halaman, totalHalaman).map((n, i) =>
+          n === '…' ? (
+            <span key={`titik-${i}`} className="paginasi-titik" aria-hidden="true">…</span>
+          ) : (
+            <button key={n} type="button" className={`pill ${n === halaman ? 'aktif' : ''}`}
+              onClick={() => pindah(n)} aria-label={`Halaman ${n}`}
+              aria-current={n === halaman ? 'page' : undefined}>{n}</button>
+          )
+        )}
+        <button type="button" className="tombol kecil netral" onClick={() => pindah(halaman + 1)}
+          disabled={halaman === totalHalaman} aria-label="Halaman berikutnya">›</button>
+      </div>
+    </nav>
+  )
+}
diff -ruN Pixel-archive-main/src/hooks/useGridPageSize.js Pixel-archive-main/src/hooks/useGridPageSize.js
--- Pixel-archive-main/src/hooks/useGridPageSize.js	1970-01-01 00:00:00.000000000 +0000
+++ Pixel-archive-main/src/hooks/useGridPageSize.js	2026-11-26 08:30:12.000000000 +0000
@@ -0,0 +1,23 @@
+import { useEffect, useState } from 'react'
+
+// Jumlah game per halaman mengikuti jumlah kolom .grid di styles.css supaya baris selalu penuh:
+//   < 900px  : 2 kolom -> 8 game  (4 baris)
+//   >= 900px : 4 kolom -> 12 game (3 baris)
+//   >= 1280px: 5 kolom -> 15 game (3 baris)
+const bacaUkuran = () => {
+  if (typeof window === 'undefined' || !window.matchMedia) return 8
+  if (window.matchMedia('(min-width: 1280px)').matches) return 15
+  if (window.matchMedia('(min-width: 900px)').matches) return 12
+  return 8
+}
+
+export default function useGridPageSize() {
+  const [ukuran, setUkuran] = useState(bacaUkuran)
+  useEffect(() => {
+    const daftar = [window.matchMedia('(min-width: 900px)'), window.matchMedia('(min-width: 1280px)')]
+    const perbarui = () => setUkuran(bacaUkuran())
+    daftar.forEach((m) => m.addEventListener('change', perbarui))
+    return () => daftar.forEach((m) => m.removeEventListener('change', perbarui))
+  }, [])
+  return ukuran
+}
diff -ruN Pixel-archive-main/src/hooks/usePagination.js Pixel-archive-main/src/hooks/usePagination.js
--- Pixel-archive-main/src/hooks/usePagination.js	1970-01-01 00:00:00.000000000 +0000
+++ Pixel-archive-main/src/hooks/usePagination.js	2026-11-26 08:30:12.000000000 +0000
@@ -0,0 +1,42 @@
+import { useCallback, useEffect, useRef } from 'react'
+import usePersistedState from './usePersistedState.js'
+import { jepit, totalHalaman as hitungTotal } from '../lib/paginasi.js'
+
+// Membagi daftar menjadi halaman-halaman.
+//  - key      : kunci sessionStorage, supaya halaman aktif bertahan saat pindah halaman lalu kembali
+//  - resetKey : string berisi filter/pencarian/urutan; saat berubah, kembali ke halaman 1
+export default function usePagination(items, perHalaman, { key, resetKey = '' }) {
+  const [tersimpan, setTersimpan] = usePersistedState(key, 1)
+
+  const total = items.length
+  const jumlah = hitungTotal(total, perHalaman)
+  // Halaman yang dipakai dihitung (diturunkan) dari nilai tersimpan, bukan ditimpakan ke state.
+  // Jadi saat data masih dimuat (daftar kosong) halaman tersimpan tidak hilang.
+  const halaman = jepit(tersimpan, total, perHalaman)
+
+  // Filter/pencarian/urutan berubah -> halaman 1. Perubahan pertama (saat dimuat) diabaikan.
+  const awal = useRef(resetKey)
+  useEffect(() => {
+    if (awal.current === resetKey) return
+    awal.current = resetKey
+    setTersimpan(1)
+  }, [resetKey, setTersimpan])
+
+  const pindah = useCallback((n) => {
+    setTersimpan(jepit(n, total, perHalaman))
+    window.scrollTo({ top: 0, behavior: 'smooth' })
+  }, [setTersimpan, total, perHalaman])
+
+  const mulai = (halaman - 1) * perHalaman
+  const potong = items.slice(mulai, mulai + perHalaman)
+
+  return {
+    potong,                              // item untuk halaman aktif
+    halaman,
+    totalHalaman: jumlah,
+    total,
+    dari: total ? mulai + 1 : 0,
+    sampai: mulai + potong.length,
+    pindah
+  }
+}
diff -ruN Pixel-archive-main/src/lib/paginasi.js Pixel-archive-main/src/lib/paginasi.js
--- Pixel-archive-main/src/lib/paginasi.js	1970-01-01 00:00:00.000000000 +0000
+++ Pixel-archive-main/src/lib/paginasi.js	2026-11-26 08:30:12.000000000 +0000
@@ -0,0 +1,21 @@
+// Logika paginasi murni (tanpa React) agar mudah diuji dan dipakai ulang.
+
+// Jumlah halaman minimal 1, walau datanya kosong.
+export const totalHalaman = (total, perHalaman) => Math.max(1, Math.ceil(total / perHalaman))
+
+// Menjepit nomor halaman ke rentang 1..totalHalaman (nilai aneh dari penyimpanan dianggap 1).
+export const jepit = (halaman, total, perHalaman) =>
+  Math.min(Math.max(1, Math.floor(Number(halaman)) || 1), totalHalaman(total, perHalaman))
+
+// Daftar tombol nomor yang ditampilkan, mis. [1, '…', 4, 5, 6, '…', 12].
+// Selalu memuat halaman pertama, terakhir, dan halaman aktif beserta tetangganya.
+export function daftarHalaman(sekarang, total) {
+  const wajib = [1, total, sekarang - 1, sekarang, sekarang + 1]
+  const urut = [...new Set(wajib)].filter((n) => n >= 1 && n <= total).sort((a, b) => a - b)
+  const hasil = []
+  urut.forEach((n, i) => {
+    if (i > 0 && n - urut[i - 1] > 1) hasil.push('…')
+    hasil.push(n)
+  })
+  return hasil
+}
